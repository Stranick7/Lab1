<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpreadsheetUI.MainPage">

    <Grid RowDefinitions="Auto, *">

        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="5">
            <HorizontalStackLayout Spacing="10">
                <Button Text="Додати рядок" Clicked="OnAddRowClicked" />
                <Button Text="Додати стовпець" Clicked="OnAddColClicked" />
                <Button Text="Зберегти" Clicked="OnSaveClicked" />
                <Button Text="Завантажити" Clicked="OnLoadClicked" />
                <Button Text="Довідка" Clicked="OnHelpClicked" />
                <Button x:Name="BtnToggleMode" Text="Режим: ВИРАЗ" Clicked="OnToggleModeClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="1" Orientation="Both" Margin="5">
            <Grid x:Name="SpreadsheetGrid" RowSpacing="2" ColumnSpacing="2" />
        </ScrollView>

    </Grid>
</ContentPage>